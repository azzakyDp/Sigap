# --- Application ---
APP_NAME=SIGAP Backend
APP_VERSION=2.0.0
APP_ENV=staging
DEBUG=true

# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/sigap_db

# --- JWT (diaktifkan penuh di Phase 3) ---
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- File / Object Storage ---
STORAGE_BACKEND=cloudinary
STORAGE_LOCAL_PATH=storage/uploads

# --- Cloudinary Storage ---
CLOUDINARY_CLOUD_NAME=sigap_lamongan
CLOUDINARY_API_KEY=699952278742168
CLOUDINARY_API_SECRET=TwtH0LM6qFkn7OqKJEw6IH3A2Xc
CLOUDINARY_FOLDER=sigap_storage

# --- AI Service ---
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.1-flash-lite
AI_MODEL_FALLBACK=gemini-2.5-flash
AI_TIMEOUT=30