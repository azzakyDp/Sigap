# --- Application ---
APP_NAME=SIGAP Backend
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/sigap_db

# --- JWT (diaktifkan penuh di Phase 3) ---
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- File / Object Storage (diaktifkan di Phase 5) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage/uploads

# --- AI Service (skeleton — diaktifkan di Phase 10, jangan diisi API key asli sebelum itu) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30